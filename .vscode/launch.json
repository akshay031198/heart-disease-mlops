{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Download & clean data",
      "type": "debugpy",
      "request": "launch",
      "module": "heart_disease.download_data",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "2. EDA",
      "type": "debugpy",
      "request": "launch",
      "module": "heart_disease.eda",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3. Train models (MLflow)",
      "type": "debugpy",
      "request": "launch",
      "module": "heart_disease.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4. Run API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "5. Smoke test API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke_test.py",
      "args": ["--requests", "20"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
